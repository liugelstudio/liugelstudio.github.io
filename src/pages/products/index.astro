---
import Layout from '../../layouts/SiteLayout.astro';
import Headline from '../../components/Headline.astro';
import NorthEast from '../../components/NorthEast.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Works — LIÜGEL STUDIO" description="LIÜGEL STUDIOのソフトウェア・開発ツール・サービス一覧です。">
  <section class="works-page-head"><div class="shell"><p class="section-overline"><span class="section-number">INDEX</span> SOFTWARE / TOOLS / SERVICES</p><h1><Headline name="works" label="Works" /></h1><p>開発中のソフトウェア・ツールと、公開サービスの情報を掲載します。</p></div></section>
  <section class="works-list-section"><div class="shell">
    <div class="work-filter" role="group" aria-label="開発作品をカテゴリーで絞り込む">
      <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">ALL <span>02</span></button>
      <button class="filter-button" type="button" data-filter="software" aria-pressed="false">SOFTWARE <span>01</span></button>
      <button class="filter-button" type="button" data-filter="tools" aria-pressed="false">TOOLS <span>01</span></button>
      <button class="filter-button" type="button" data-filter="services" aria-pressed="false">SERVICES <span>00</span></button>
    </div>
    <div class="works-index-grid">
      <a class="work-unit work-unit-main" data-category="software" href={`${base}products/vrccm/`}><div class="work-image work-image-vrccm"><div class="work-corner-tag">01 / APPLICATION</div><div class="work-pattern-rings" aria-hidden="true"></div><span class="work-giant">V</span><span class="work-image-label">VRC CACHE MANAGER</span><span class="image-open" aria-hidden="true"><NorthEast /></span></div><div class="work-label"><div><span><span lang="en">WINDOWS APPLICATION</span> · 開発中</span><h2>VRCCM</h2><p><span lang="en">VRChat</span>のキャッシュ管理を支援する<span lang="en">Windows</span>向けツール</p></div><span class="work-arrow" aria-hidden="true"><NorthEast /></span></div></a>
      <a class="work-unit work-unit-sub" data-category="tools" href={`${base}technology/`}><div class="work-image work-image-editor"><div class="work-corner-tag">02 / DEVELOPER TOOL</div><div class="code-pattern" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><div class="editor-visual-word" aria-hidden="true">{`{ }`}</div><span class="work-image-label">EDITOR / COMPONENT</span><span class="image-open" aria-hidden="true"><NorthEast /></span></div><div class="work-label"><div><span><span lang="en">DEVELOPER LIBRARY</span> · 開発中</span><h2>Liugel.Editor</h2><p>軽量コードエディターライブラリ</p></div><span class="work-arrow" aria-hidden="true"><NorthEast /></span></div></a>
    </div>
    <div class="works-empty" id="works-empty" hidden><strong>現在、掲載中のサービスはありません。</strong><p>公開可能なサービスができ次第、こちらに追加します。</p></div>
    <p class="works-caption">※ ビジュアルはコンセプトグラフィックであり、実際の製品画面ではありません。</p>
  </div></section>
  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
    const entries = Array.from(document.querySelectorAll<HTMLElement>('.works-index-grid [data-category]'));
    const empty = document.querySelector<HTMLElement>('#works-empty');
    const allowed = ['all', 'software', 'tools', 'services'];
    function applyFilter(value: string) {
      const filter = allowed.includes(value) ? value : 'all';
      buttons.forEach(button => {
        const selected = button.dataset.filter === filter;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
      let visible = 0;
      entries.forEach(entry => {
        const show = filter === 'all' || entry.dataset.category === filter;
        entry.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible !== 0;
    }
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      applyFilter(filter);
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('category'); else url.searchParams.set('category', filter);
      window.history.replaceState(null, '', url);
    }));
    applyFilter(new URL(window.location.href).searchParams.get('category') ?? 'all');
  </script>
</Layout>
