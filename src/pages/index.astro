---
import Layout from '../layouts/SiteLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import NorthEast from '../components/NorthEast.astro';
import Headline from '../components/Headline.astro';
const base = import.meta.env.BASE_URL;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'LIÜGEL STUDIO',
  url: 'https://liugelstudio.github.io/',
  logo: 'https://liugelstudio.github.io/favicon.svg',
};

---
<Layout title="LIÜGEL STUDIO — ソフトウェア・ツール・サービスの開発" description="LIÜGEL STUDIO公式サイト。VRCCM、Liugel.Editorなどのソフトウェア・ツール・開発技術を紹介します。">
  <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  <section class="showcase" aria-labelledby="showcase-title">
    <picture class="showcase-media" aria-hidden="true">
      <source type="image/avif" srcset={`${base}assets/hero/liugel-studio-hero-768.avif 768w, ${base}assets/hero/liugel-studio-hero-1200.avif 1200w, ${base}assets/hero/liugel-studio-hero-1920.avif 1920w`} sizes="100vw" />
      <source type="image/webp" srcset={`${base}assets/hero/liugel-studio-hero-768.webp 768w, ${base}assets/hero/liugel-studio-hero-1200.webp 1200w, ${base}assets/hero/liugel-studio-hero-1920.webp 1920w`} sizes="100vw" />
      <img class="showcase-backdrop" src={`${base}assets/hero/liugel-studio-hero.png`} width="1672" height="941" alt="" decoding="async" fetchpriority="high" />
    </picture>
    <div class="showcase-frame shell">
      <div class="showcase-meta"><span class="meta-dot"></span> LIÜGEL STUDIO <span class="meta-slash">/</span> OFFICIAL WEBSITE <span class="meta-right">SOFTWARE / TOOLS / SERVICES</span></div>
      <div class="showcase-grid">
        <div class="showcase-copy">
          <p class="micro-title">INDEPENDENT DEVELOPMENT STUDIO</p>
          <h1 id="showcase-title" class="showcase-logo-heading"><BrandLogo class="showcase-brand-logo" /></h1>
          <p class="showcase-subtitle">ソフトウェア・ツール・サービス</p>
          <p class="showcase-desc"><span lang="en">Windows</span>向けアプリケーションや開発者向けライブラリなど、さまざまなソフトウェアを個人で開発しています。</p>
          <div class="showcase-buttons"><a class="solid-link" href={`${base}products/`}>開発作品を見る <span aria-hidden="true"><NorthEast /></span></a><a class="under-link" href={`${base}about/`}>スタジオについて <span aria-hidden="true">→</span></a></div>
        </div>
      </div>
      <div class="showcase-bottom"><span>SOFTWARE <b>／</b> TOOLS <b>／</b> SERVICES</span><a href="#works">SCROLL TO WORKS ↓</a></div>
    </div>
  </section>

  <section class="works-section" id="works" aria-labelledby="works-heading">
    <div class="shell">
      <div class="section-heading"><div><p class="section-overline"><span class="section-number">01</span> SELECTED WORKS</p><h2 id="works-heading"><Headline name="works" variant="top" label="Works" /></h2><p class="section-jp">ソフトウェア・ツールの開発作品</p></div><a class="outline-link" href={`${base}products/`}>一覧を見る <span aria-hidden="true"><NorthEast /></span></a></div>
      <div class="work-feature-grid">
        <a class="work-unit work-unit-main" href={`${base}products/vrccm/`}>
          <div class="work-image work-image-vrccm"><div class="work-corner-tag">01 / APPLICATION</div><div class="work-pattern-rings" aria-hidden="true"></div><span class="work-giant">V</span><span class="work-image-label">VRC CACHE MANAGER</span><span class="image-open" aria-hidden="true"><NorthEast /></span></div>
          <div class="work-label"><div><span><span lang="en">WINDOWS APPLICATION</span> · 開発中</span><h3>VRCCM</h3><p><span lang="en">VRChat</span>のキャッシュ管理を支援する<span lang="en">Windows</span>向けツール</p></div><span class="work-arrow" aria-hidden="true"><NorthEast /></span></div>
        </a>
        <a class="work-unit work-unit-sub" href={`${base}technology/`}>
          <div class="work-image work-image-editor"><div class="work-corner-tag">02 / DEVELOPER TOOL</div><div class="code-pattern" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><div class="editor-visual-word" aria-hidden="true">{`{ }`}</div><span class="work-image-label">EDITOR / COMPONENT</span><span class="image-open" aria-hidden="true"><NorthEast /></span></div>
          <div class="work-label"><div><span><span lang="en">DEVELOPER LIBRARY</span> · 開発中</span><h3>Liugel.Editor</h3><p>軽量コードエディターライブラリ</p></div><span class="work-arrow" aria-hidden="true"><NorthEast /></span></div>
        </a>
      </div>
      <p class="works-caption">※ 画像は製品のイメージグラフィックです。実際のアプリ画面ではありません。</p>
    </div>
  </section>

  <section class="categories-section" aria-labelledby="categories-heading"><div class="shell">
    <div class="section-heading section-heading-dark"><div><p class="section-overline"><span class="section-number">02</span> DEVELOPMENT AREAS</p><h2 id="categories-heading"><Headline name="categories" variant="top" label="Categories" /></h2><p class="section-jp">開発分野</p></div></div>
    <div class="category-list">
      <a href={`${base}products/?category=software`}><span class="category-count">01</span><strong><Headline name="software" variant="top" label="Software" /></strong><span class="category-note"><span lang="en">Windows</span>向けアプリケーション</span><span class="category-arrow" aria-hidden="true"><NorthEast /></span></a>
      <a href={`${base}products/?category=tools`}><span class="category-count">02</span><strong><Headline name="tools" variant="top" label="Tools" /></strong><span class="category-note">開発ツール・ライブラリ</span><span class="category-arrow" aria-hidden="true"><NorthEast /></span></a>
      <a href={`${base}products/?category=services`}><span class="category-count">03</span><strong><Headline name="services" variant="top" label="Services" /></strong><span class="category-note">公開サービスは現在準備中</span><span class="category-arrow" aria-hidden="true"><NorthEast /></span></a>
    </div>
  </div></section>

  <section class="studio-news" aria-labelledby="studio-news-heading"><div class="shell studio-news-grid">
    <div class="studio-panel"><p class="section-overline"><span class="section-number">03</span> THE STUDIO</p><h2 id="studio-news-heading"><Headline name="about" variant="top" label="About" /></h2><p><span lang="en">LIÜGEL STUDIO</span>（リューゲルスタジオ）は、ソフトウェアと開発者向け技術を制作する個人開発スタジオです。</p><a class="outline-link" href={`${base}about/`}>スタジオについて <span aria-hidden="true"><NorthEast /></span></a></div>
    <div class="news-panel"><p class="section-overline"><span class="section-number">04</span> UPDATES</p><h2><Headline name="news" variant="top" label="News" /></h2><div class="news-placeholder"><span class="news-placeholder-line"></span><span>公開可能な更新情報を準備中です。</span></div><a class="outline-link" href={`${base}news/`}>ニュース一覧 <span aria-hidden="true"><NorthEast /></span></a></div>
  </div></section>

  <section class="contact-strip"><div class="shell contact-strip-inner"><div><div class="contact-strip-headline"><Headline name="contact" variant="top" label="Contact" /></div><h2>お問い合わせ・サポート</h2></div><a href={`${base}contact/`}>連絡窓口を見る <span aria-hidden="true"><NorthEast /></span></a></div></section>
</Layout>
