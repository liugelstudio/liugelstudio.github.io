---
import logoMarkup from '../assets/brand/logo.svg?raw';
interface Props { class?: string; decorative?: boolean; }
const { class: className = '', decorative = false } = Astro.props;
---
<span class={className} role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : 'LIÜGEL STUDIO'} aria-hidden={decorative ? 'true' : undefined}>
  <Fragment set:html={logoMarkup} />
</span>
