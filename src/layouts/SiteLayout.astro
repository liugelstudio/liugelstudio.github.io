---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import NorthEast from '../components/NorthEast.astro';
const { title = 'LIÜGEL STUDIO', description = 'LIÜGEL STUDIOの公式サイト。ソフトウェア、開発者向けツール、技術情報を掲載しています。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://liugelstudio.github.io/').href;
const ogImage = new URL(`${base}og-image.jpg`, Astro.site ?? 'https://liugelstudio.github.io/').href;
const link = (path = '') => `${base}${path}`;
const nav = [
  { name: 'Works', path: 'products/' },
  { name: 'Technology', path: 'technology/' },
  { name: 'News', path: 'news/' },
  { name: 'About', path: 'about/' },
  { name: 'Docs', path: 'docs/' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e13" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LIÜGEL STUDIO" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={link('apple-touch-icon.png')} />
  </head>
  <body>
    <a class="skip" href="#content">本文へ移動</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={link()} aria-label="LIÜGEL STUDIO トップページ"><BrandLogo decorative /></a>
        <span class="header-divider" aria-hidden="true"></span>
        <span class="header-type">SOFTWARE DEVELOPMENT STUDIO</span>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {nav.map(item => <a href={link(item.path)} aria-current={Astro.url.pathname === link(item.path) ? 'page' : undefined}>{item.name}</a>)}
        </nav>
        <a class="header-contact" href={link('contact/')}>Contact <span aria-hidden="true"><NorthEast /></span></a>
        <details class="mobile-menu">
          <summary aria-expanded="false"><span class="mobile-menu-lines" aria-hidden="true"><i></i><i></i></span><span>MENU</span></summary>
          <nav aria-label="モバイルナビゲーション">
            <a href={link()}>Home <span aria-hidden="true"><NorthEast /></span></a>
            {nav.map(item => <a href={link(item.path)}>{item.name} <span aria-hidden="true"><NorthEast /></span></a>)}
            <a href={link('contact/')}>Contact <span aria-hidden="true"><NorthEast /></span></a>
          </nav>
        </details>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-main">
        <div class="footer-identity">
          <BrandLogo />
          <p><span lang="en">Windows</span>向けソフトウェア、開発者向けツール・ライブラリなどを個人で開発しています。</p>
        </div>
        <nav class="footer-nav" aria-label="フッターナビゲーション">
          <a href={link('products/')}>Works</a>
          <a href={link('technology/')}>Technology</a>
          <a href={link('news/')}>News</a>
          <a href={link('about/')}>About</a>
          <a href={link('docs/')}>Docs</a>
          <a href={link('contact/')}>Contact</a>
        </nav>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} LIÜGEL STUDIO</span><span>INDEPENDENT SOFTWARE DEVELOPMENT / JAPAN</span><a href="#content">BACK TO TOP ↑</a></div>
    </footer>
    <script>
      const menus = document.querySelectorAll<HTMLDetailsElement>('.mobile-menu');
      menus.forEach(menu => {
        const summary = menu.querySelector<HTMLElement>('summary');
        if (!summary) return;
        const syncExpanded = () => summary.setAttribute('aria-expanded', String(menu.open));
        menu.addEventListener('toggle', syncExpanded);
        syncExpanded();
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            summary.focus();
          }
        });
        document.addEventListener('pointerdown', event => {
          if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
        });
      });
    </script>
  </body>
</html>
